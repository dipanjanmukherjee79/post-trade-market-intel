```mermaid
flowchart TD
    %% External Sources
    subgraph SRC["External Sources"]
        FRED[/"FRED API<br/>VIXCLS series"/]
        YAHOO[/"Yahoo Finance<br/>GSPC daily OHLCV"/]
    end

    %% Orchestration
    GHA{{"GitHub Actions<br/>cron 22:00 UTC"}}

    %% Ingestion
    subgraph ING["Ingestion — src/ingestion"]
        FREDIN["FRED Ingestor"]
        YHIN["Yahoo Ingestor"]
    end

    %% Bronze Layer
    subgraph BRONZE["Raw / Bronze — data/raw"]
        VIXRAW[("VIX Raw<br/>Parquet")]
        SPRAW[("S&P 500 Raw<br/>Parquet")]
    end

    %% Transformation + Quality
    subgraph TRAN["Transformation and Quality — src/transformation, src/quality"]
        ALIGN["Alignment and<br/>TZ Normaliser"]
        DQ["DQ Validator<br/>schema and range checks"]
    end

    QLOG[("Quarantine Log<br/>logs/dq_quarantine.log")]

    %% Silver Layer
    SILVER[("Curated / Silver<br/>data/curated<br/>aligned.parquet")]

    %% Metric Layer
    subgraph MET["Metric Layer — src/metrics, src/signals"]
        SMA["20-day SMA<br/>S&P close"]
        PCT["Daily % Change<br/>S&P close"]
        SIG["RAG Signal<br/>VIX bands"]
    end

    %% Gold Layer
    GOLD[("Serving / Gold<br/>data/serving<br/>metrics.parquet")]

    %% Presentation
    DASH(["Streamlit Dashboard<br/>Streamlit Cloud"])

    %% Trigger flow (dashed = control plane)
    GHA -.->|triggers| FREDIN
    GHA -.->|triggers| YHIN

    %% Ingestion (data plane)
    FRED -->|HTTP CSV| FREDIN
    YAHOO -->|HTTP CSV| YHIN

    %% To bronze
    FREDIN -->|write| VIXRAW
    YHIN -->|write| SPRAW

    %% To transformation
    VIXRAW -->|SQL read| ALIGN
    SPRAW -->|SQL read| ALIGN
    ALIGN -->|aligned rows| DQ

    %% Split valid / invalid (quarantine pattern)
    DQ -->|valid rows| SILVER
    DQ -.->|invalid rows| QLOG

    %% Metric computation reads silver
    SILVER -->|SQL read| SMA
    SILVER -->|SQL read| PCT
    SILVER -->|latest VIX| SIG

    %% To gold
    SMA -->|metric output| GOLD
    PCT -->|metric output| GOLD
    SIG -->|signal output| GOLD

    %% Dashboard reads only gold
    GOLD -->|SQL via DuckDB| DASH

    %% Layer styling (consistent with arch-diagram colour palette)
    classDef external fill:#f5f5f5,stroke:#555555,color:#000000
    classDef orch fill:#d5e8d4,stroke:#82b366,color:#000000
    classDef storage fill:#f8cecc,stroke:#b85450,color:#000000
    classDef processing fill:#fff2cc,stroke:#d6b656,color:#000000
    classDef ui fill:#dae8fc,stroke:#6c8ebf,color:#000000

    class FRED,YAHOO external
    class GHA orch
    class FREDIN,YHIN,ALIGN,DQ,SMA,PCT,SIG processing
    class VIXRAW,SPRAW,SILVER,GOLD,QLOG storage
    class DASH ui
```
