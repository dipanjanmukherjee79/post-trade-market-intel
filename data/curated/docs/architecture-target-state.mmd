```mermaid
flowchart TD
    %% External Sources (expanded — more than just two)
    subgraph SRC["External Sources"]
        EXT1[/"Market Data<br/>FRED, Yahoo, Bloomberg, Refinitiv"/]
        EXT2[/"Macro Data<br/>RBA, ECB, central banks"/]
        EXT3[/"Internal Systems<br/>trade capture, RDS, files"/]
    end

    %% Orchestration & Ingestion
    subgraph ORCHIN["Orchestration & Ingestion"]
        SCHED["Workflow Orchestrator<br/>Airflow / Dagster / managed"]
        INGEST["Ingestion Framework<br/>batch + streaming (CDC)"]
    end

    %% Lakehouse Storage (object store + open table format)
    subgraph LAKE["Lakehouse Storage Platform"]
        BRONZE[("Bronze<br/>Object Store<br/>S3 / ADLS / GCS<br/>raw, immutable")]
        SILVER[("Silver<br/>Open Table Format<br/>Iceberg / Delta<br/>curated, validated")]
        GOLD[("Gold<br/>Open Table Format<br/>marts, metrics")]
    end

    %% Compute & Transformation
    subgraph COMPUTE["Compute and Transformation"]
        QUERY["Query Engine<br/>Trino / Databricks SQL /<br/>Snowflake"]
        DBT["Transformation Framework<br/>dbt / SQLMesh"]
        DQ["Data Quality Engine<br/>Great Expectations / Soda /<br/>built-in lakehouse DQ"]
    end

    %% Metric / Semantic Layer
    METRIC["Metric / Semantic Layer<br/>governed metric definitions<br/>(MetricFlow / Cube / proprietary)"]

    %% Serving — multiple consumers, not just dashboards
    subgraph SERVE["Serving Layer"]
        API["Metrics API<br/>governed, versioned"]
        DASH(["BI Dashboards<br/>Streamlit / Tableau / Power BI"])
        ALERT["Alerts &<br/>Downstream Consumers"]
        ML(["Models &<br/>Feature Store"])
    end

    %% Governance Plane — cross-cutting
    subgraph GOV["Governance Plane (cross-cutting)"]
        CAT["Data Catalog<br/>DataHub / Atlan / Collibra"]
        LIN["Lineage Tracking"]
        CONT["Schema Registry<br/>and Data Contracts"]
        ACL["Access Control<br/>RBAC / ABAC / OPA"]
        AUDIT[("Audit Log<br/>immutable")]
    end

    %% Observability Plane — cross-cutting
    subgraph OBS["Observability Plane (cross-cutting)"]
        PIPE["Pipeline Observability<br/>runs, failures, SLAs"]
        DATA["Data Observability<br/>freshness, volume, drift"]
        COST["Cost Monitoring<br/>per-query, per-pipeline"]
    end

    %% Main data flow
    SCHED -.->|triggers| INGEST
    EXT1 --> INGEST
    EXT2 --> INGEST
    EXT3 --> INGEST
    INGEST -->|land raw| BRONZE
    BRONZE --> QUERY
    QUERY --> DBT
    DBT -->|silver models| SILVER
    SILVER --> DBT
    DBT -->|gold models| GOLD
    SILVER --> DQ
    GOLD --> DQ
    GOLD --> METRIC
    METRIC --> API
    METRIC --> DASH
    METRIC --> ALERT
    METRIC --> ML

    %% Cross-cutting connections (single representative arrows — implies "applies to all layers")
    GOV -.->|enforced across all layers| LAKE
    OBS -.->|monitors all layers| ORCHIN

    %% Layer styling (consistent with arch-diagram palette)
    classDef external fill:#f5f5f5,stroke:#555555,color:#000000
    classDef orch fill:#d5e8d4,stroke:#82b366,color:#000000
    classDef storage fill:#f8cecc,stroke:#b85450,color:#000000
    classDef processing fill:#fff2cc,stroke:#d6b656,color:#000000
    classDef ui fill:#dae8fc,stroke:#6c8ebf,color:#000000
    classDef gov fill:#e1d5e7,stroke:#9673a6,color:#000000

    class EXT1,EXT2,EXT3 external
    class SCHED,INGEST orch
    class BRONZE,SILVER,GOLD,AUDIT storage
    class QUERY,DBT,DQ,METRIC processing
    class API,DASH,ALERT,ML ui
    class CAT,LIN,CONT,ACL,PIPE,DATA,COST gov
```
